ACCUFLOW_ENVIRONMENT=development
ACCUFLOW_LOG_LEVEL=INFO
ACCUFLOW_DATABASE_PATH=data/accuflow.db
ACCUFLOW_INITIAL_SYMBOLS=AAPL,NVDA
ACCUFLOW_IBKR_HOST=127.0.0.1
ACCUFLOW_IBKR_PORT=4002
ACCUFLOW_IBKR_CLIENT_ID=17
ACCUFLOW_IBKR_CONNECT_TIMEOUT=6
ACCUFLOW_IBKR_REQUEST_TIMEOUT=60
ACCUFLOW_IBKR_MARKET_DATA_TYPE=1
ACCUFLOW_IBKR_CONNECT_ON_STARTUP=false
ACCUFLOW_API_HOST=127.0.0.1
ACCUFLOW_API_PORT=8000

# 自动监测在控制台设置中开启；以下为工作流资源与超时上限。
ACCUFLOW_WORKFLOW_POLL_SECONDS=30
ACCUFLOW_WORKFLOW_STOCK_TIMEOUT=900
ACCUFLOW_WORKFLOW_JOB_TIMEOUT=3600

# M3：默认仅预览；配置完整并明确选择发送后再设为 true。
ACCUFLOW_SMTP_ENABLED=false
ACCUFLOW_SMTP_HOST=
ACCUFLOW_SMTP_PORT=587
ACCUFLOW_SMTP_SECURITY=starttls
ACCUFLOW_SMTP_USERNAME=
ACCUFLOW_SMTP_PASSWORD=
ACCUFLOW_SMTP_SENDER=
ACCUFLOW_SMTP_RECIPIENTS=
ACCUFLOW_SMTP_TIMEOUT=10
ACCUFLOW_DELIVERY_POLL_SECONDS=10
ACCUFLOW_DELIVERY_MAX_ATTEMPTS=5
ACCUFLOW_METRICS_INTERVAL_SECONDS=30
ACCUFLOW_METRICS_RETENTION_DAYS=14
